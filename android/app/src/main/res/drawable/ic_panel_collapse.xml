<?xml version="1.0" encoding="utf-8"?>
<!-- Collapse/up chevron for the floating panel header: click collapses the
     expanded panel back to the capsule. Mirrors the Web frontend's ChevronUp
     (lucide, stroke-based) so the floating window stays consistent with the
     desktop UI. Colored at runtime via ImageView tint (FloatingThemeColors
     textSecondary). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#8b949e">
    <path
        android:pathData="M18,15L12,9L6,15"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
